<!DOCTYPE html>
<html>
	<head>
		<meta charset="utf-8" />
		<title>GitUi79 - TEST</title>

		<!-- px2style -->
		<link rel="stylesheet" href="./common/px2style/px2style.css" />
		{% if appearance == 'darkmode' %}
		<link rel="stylesheet" href="./common/px2style/themes/darkmode.css" />
		{% elseif appearance == 'lightmode' %}
		<link rel="stylesheet" href="./common/px2style/themes/default.css" />
		{% else %}
		<link rel="stylesheet" href="./common/px2style/themes/auto.css" />
		{% endif %}

		<!-- gitui79.css -->
		<link rel="stylesheet" href="./common/gitui79/gitui79.css" />
		{% if appearance == 'darkmode' %}
		<style>
        body{
            color: #ddd;
            background-color: #333;
        }
		</style>
		<link rel="stylesheet" href="./common/gitui79/themes/darkmode.css" />
		{% elseif appearance == 'lightmode' %}
		<style>
        body{
            color: #333;
            background-color: #eee;
        }
		</style>
		<link rel="stylesheet" href="./common/gitui79/themes/lightmode.css" />
		{% else %}
		<style>
		@media (prefers-color-scheme: light) {
			body{
				color: #333;
				background-color: #eee;
			}
		}
		@media (prefers-color-scheme: dark) {
			body{
				color: #ddd;
				background-color: #333;
			}
		}
		</style>
		<link rel="stylesheet" href="./common/gitui79/themes/default.css" />
		{% endif %}

		<!-- darkmode -->
		<!-- <style>
		body {
			background-color: #333;
			color: #ddd;
		}
		</style>
		<link rel="stylesheet" href="./common/gitui79/themes/darkmode.css" /> -->

		<!-- contents.css -->
		<link rel="stylesheet" href="./index_files/contents.css" />
	</head>
	<body class="_px2-darkmode">

<h1>GitUi79 TEST</h1>
<div id="cont-gitui79"></div>


<script>
window.lang = '{% if lang %}{{ lang }}{% else %}en{% endif %}';
</script>

<!-- jQuery -->
<script src="./libs/scripts/jquery-3.4.1.min.js"></script>

<!-- px2style -->
<script src="./common/px2style/px2style.js"></script>

<!-- gitui79.js -->
<script src="./common/gitui79/gitui79.js"></script>

<!-- contents.js -->
<script src="./index_files/contents.js"></script>

	</body>
</html>

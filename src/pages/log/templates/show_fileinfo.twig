<div class="px2-p">
    <table class="px2-table px2-table--dl">
        <tr>
            <th>File</th>
            <td>{{ file|e }}</td>
        </tr>
        <tr>
            <th>Status</th>
            <td>{{ status|e }}</td>
        </tr>
    </table>
</div>

{% if isImage %}
<h2>画像差分</h2>
<div class="gitui79__image-diff">
    {% if imageDataBefore and imageDataAfter %}
    {# 変更ファイルの場合: Before と After を左右に表示 #}
    <div class="gitui79__image-diff-container">
        <div class="gitui79__image-diff-side">
            <div class="gitui79__image-diff-label">Before</div>
            <div class="gitui79__image-diff-content">
                <img src="data:{{ mimeType|e }};base64,{{ imageDataBefore|e }}" alt="Before">
            </div>
        </div>
        <div class="gitui79__image-diff-side">
            <div class="gitui79__image-diff-label">After</div>
            <div class="gitui79__image-diff-content">
                <img src="data:{{ mimeType|e }};base64,{{ imageDataAfter|e }}" alt="After">
            </div>
        </div>
    </div>
    {% elseif imageDataBefore %}
    {# 削除ファイルの場合: Before のみ表示 #}
    <div class="gitui79__image-diff-single">
        <div class="gitui79__image-diff-label">Deleted</div>
        <div class="gitui79__image-diff-content">
            <img src="data:{{ mimeType|e }};base64,{{ imageDataBefore|e }}" alt="Deleted Image">
        </div>
    </div>
    {% elseif imageDataAfter %}
    {# 新規ファイルの場合: After のみ表示 #}
    <div class="gitui79__image-diff-single">
        <div class="gitui79__image-diff-label">Added</div>
        <div class="gitui79__image-diff-content">
            <img src="data:{{ mimeType|e }};base64,{{ imageDataAfter|e }}" alt="Added Image">
        </div>
    </div>
    {% endif %}
</div>
{% elseif code or diffHtmlLineByLine %}
<h2>差分</h2>
{% if diffHtmlLineByLine %}
<div class="gitui79__sm">{{ diffHtmlLineByLine | raw }}</div>
<div class="gitui79__lg">{{ diffHtmlSideBySide | raw }}</div>
{% endif %}
{% endif %}

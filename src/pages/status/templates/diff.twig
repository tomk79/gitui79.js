<div class="px2-p">
    <table class="px2-table px2-table--dl">
        <tr>
            <th>{{ lb.get("status.file") }}</th>
            <td>{{ file|e }}</td>
        </tr>
        <tr>
            <th>{{ lb.get("ui_label.status") }}</th>
            <td>{{ status|e }}</td>
        </tr>
        <tr>
            <th>{{ lb.get("status.is_staged") }}</th>
            <td>{{ isStaged|e }}</td>
        </tr>
    </table>
</div>

{% if status == "unmerged" %}
<div class="px2-p">
    <p>{{ lb.get("status.conflict") }}</p>
    <button class="px2-btn gitui79__resolve-ours" type="button">{{ lb.get("status.resolve_ours") }}</button>
    <button class="px2-btn gitui79__resolve-theirs" type="button">{{ lb.get("status.resolve_theirs") }}</button>
</div>
{% endif %}

{% if isImage %}
<h2>{{ lb.get("ui_label.image_diff") }}</h2>
<div class="gitui79__image-diff">
    {% if imageDataBefore and imageDataAfter %}
    {# 変更ファイルの場合: Before と After を左右に表示 #}
    <div class="gitui79__image-diff-container">
        <div class="gitui79__image-diff-side">
            <div class="gitui79__image-diff-label">{{ lb.get("ui_label.before") }}</div>
            <div class="gitui79__image-diff-content">
                <img src="data:{{ mimeType|e }};base64,{{ imageDataBefore|e }}" alt="{{ lb.get('ui_label.image_alt_before') }}">
            </div>
            {% if imageMetadataBefore %}
            <div class="gitui79__image-metadata">
                <div>{{ lb.get("ui_label.size") }}: {{ imageMetadataBefore.width }}x{{ imageMetadataBefore.height }}</div>
                <div>{{ lb.get("ui_label.format") }}: {{ imageMetadataBefore.format|e }}</div>
                <div>{{ lb.get("ui_label.capacity") }}: {{ imageMetadataBefore.sizeFormatted|e }}</div>
            </div>
            {% endif %}
        </div>
        <div class="gitui79__image-diff-side">
            <div class="gitui79__image-diff-label">{{ lb.get("ui_label.after") }}{% if isStaged == 'staged' %} ({{ lb.get("ui_label.staged") }}){% else %} ({{ lb.get("ui_label.working_tree") }}){% endif %}</div>
            <div class="gitui79__image-diff-content">
                <img src="data:{{ mimeType|e }};base64,{{ imageDataAfter|e }}" alt="{{ lb.get('ui_label.image_alt_after') }}">
            </div>
            {% if imageMetadataAfter %}
            <div class="gitui79__image-metadata">
                <div>{{ lb.get("ui_label.size") }}: {{ imageMetadataAfter.width }}x{{ imageMetadataAfter.height }}</div>
                <div>{{ lb.get("ui_label.format") }}: {{ imageMetadataAfter.format|e }}</div>
                <div>{{ lb.get("ui_label.capacity") }}: {{ imageMetadataAfter.sizeFormatted|e }}</div>
            </div>
            {% endif %}
        </div>
    </div>
    {% elseif imageDataBefore %}
    {# 削除ファイルまたはunstagedの変更ファイル（作業ツリーを取得できない場合） #}
    <div class="gitui79__image-diff-single">
        <div class="gitui79__image-diff-label">{% if status == 'deleted' %}{{ lb.get("ui_label.deleted") }}{% else %}{{ lb.get("ui_label.before") }}{% endif %}</div>
        <div class="gitui79__image-diff-content">
            <img src="data:{{ mimeType|e }};base64,{{ imageDataBefore|e }}" alt="{% if status == 'deleted' %}{{ lb.get('ui_label.image_alt_deleted') }}{% else %}{{ lb.get('ui_label.image_alt_before') }}{% endif %}">
        </div>
        {% if imageMetadataBefore %}
        <div class="gitui79__image-metadata">
            <div>{{ lb.get("ui_label.size") }}: {{ imageMetadataBefore.width }}x{{ imageMetadataBefore.height }}</div>
            <div>{{ lb.get("ui_label.format") }}: {{ imageMetadataBefore.format|e }}</div>
            <div>{{ lb.get("ui_label.capacity") }}: {{ imageMetadataBefore.sizeFormatted|e }}</div>
        </div>
        {% endif %}
        {% if status != 'deleted' and isStaged != 'staged' %}
        <p class="px2-p" style="color: #666; font-size: 14px;">{{ lb.get("status.untracked_image_note") }}</p>
        {% endif %}
    </div>
    {% elseif imageDataAfter %}
    {# 新規ファイルの場合: After のみ表示 #}
    <div class="gitui79__image-diff-single">
        <div class="gitui79__image-diff-label">{{ lb.get("ui_label.added") }}{% if isStaged == 'staged' %} ({{ lb.get("ui_label.staged") }}){% endif %}</div>
        <div class="gitui79__image-diff-content">
            <img src="data:{{ mimeType|e }};base64,{{ imageDataAfter|e }}" alt="{{ lb.get('ui_label.image_alt_added') }}">
        </div>
        {% if imageMetadataAfter %}
        <div class="gitui79__image-metadata">
            <div>{{ lb.get("ui_label.size") }}: {{ imageMetadataAfter.width }}x{{ imageMetadataAfter.height }}</div>
            <div>{{ lb.get("ui_label.format") }}: {{ imageMetadataAfter.format|e }}</div>
            <div>{{ lb.get("ui_label.capacity") }}: {{ imageMetadataAfter.sizeFormatted|e }}</div>
        </div>
        {% endif %}
    </div>
    {% else %}
    {# untrackedファイルで画像を取得できない場合 #}
    <div class="px2-p">
        <p style="color: #666;">{{ lb.get("status.untracked_image_note") }}</p>
    </div>
    {% endif %}
</div>
{% elseif code or diffHtmlLineByLine %}
<h2>{{ lb.get("status.diff") }}</h2>
{% if diffHtmlLineByLine %}
<div class="gitui79__sm">{{ diffHtmlLineByLine | raw }}</div>
<div class="gitui79__lg">{{ diffHtmlSideBySide | raw }}</div>
{% endif %}
{% if code %}
<!-- <pre><code>{{ code|e }}</code></pre> -->
{% endif %}
{% endif %}
